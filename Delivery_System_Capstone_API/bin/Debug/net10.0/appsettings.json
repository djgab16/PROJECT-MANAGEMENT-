{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SPXDeliveryDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "SPXDeliveryAPI",
    "Audience": "SPXDeliveryFrontend",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "FileStorage": {
    "PodImagesPath": "uploads/pod-images",
    "MaxFileSizeBytes": 5242880
  },
  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "SlaThresholds": {
    "High": 24,
    "Medium": 48,
    "Low": 72,
    "Default": 48
  },
  "AllowedHosts": "*"
}
